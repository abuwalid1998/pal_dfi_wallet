# ==============================================================================
# Ministry of Interior (MoI) - Palestinian Digital National ID Container
# Pilot Environment Configuration Template
# ==============================================================================

# Application Port (Default: 9000)
MOI_PORT=9000
PORT=9000
HOST=0.0.0.0

# Environment Mode (production / staging / development)
NODE_ENV=production
PILOT_ENVIRONMENT=production-pilot
APP_VERSION=1.0.0-pilot

# Data Directory for Persistent Storage (Maps to /app/data in Docker)
DATA_DIR=/app/data

# Security & Ingress CORS Configuration
CORS_ORIGIN=*

# Government Service Bus (GSB) Integration Hook
GSB_GATEWAY_URL=http://gsb.gov.ps/api/v1
GSB_API_KEY=moi_gsb_pilot_token_sec_99120

# PMA ID+ Banking Gateway Integration Hook
PMA_ID_PLUS_URL=http://idplus.pma.ps/api/v1
PMA_CLIENT_ID=moi_pilot_client

# Hyperledger Fabric Consortium Gateway
FABRIC_CHANNEL=pal-sovereign-channel
FABRIC_CHAINCODE=moi_national_id_cc
FABRIC_PEER_ENDPOINT=peer0.moi.gov.ps:7051
